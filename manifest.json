{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "__MSG_extensionShortName__",
  "version": "2.4.6",
  "description": "__MSG_extensionDescription__",
  "homepage_url": "https://github.com/modcoretech/modcore-extension-manager",
  "author": "modcore",
  "offline_enabled": true,
  "permissions": [
    "storage",
    "management",
    "commands",
    "alarms",
    "tabs",
    "downloads",
    "contextMenus",
    "sidePanel"
  ],
  "background": {
    "service_worker": "src/js/entry/service-worker.js",
    "type": "module"
  },
  "host_permissions": [
    "https://chrome.google.com/webstore/detail/",
    "https://chromewebstore.google.com/detail/",
    "https://clients2.google.com/"
  ],
  "side_panel": {
    "default_path": "src/views/popup/popup.html"
  },
  "action": {
    "default_title": "modcore Extension Manager",
    "default_popup": "src/views/popup/popup.html",
    "default_icon": {
      "128": "public/icons/png/modcore-em.png"
    }
  },
  "icons": {
    "128": "public/icons/png/modcore-em.png"
  },
  "options_ui": {
    "page": "src/views/snapshot/snapshot.html",
    "open_in_tab": true
  },
  "default_locale": "en",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "commands": {
    "download-crx": {
      "suggested_key": {
        "default": "Ctrl+Shift+D"
      },
      "description": "__MSG_command_download_crx__"
    }
  }
}
